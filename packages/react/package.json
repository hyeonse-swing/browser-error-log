{
  "name": "browser-error-log-react",
  "version": "0.1.1",
  "description": "A React Error Boundary adapter for the self-hosted Browser Error Log SDK.",
  "keywords": [
    "react",
    "error-boundary",
    "error-monitoring",
    "self-hosted"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "dependencies": {
    "browser-error-log": "0.1.1"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyeonse-swing/browser-error-log.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/hyeonse-swing/browser-error-log#readme",
  "bugs": {
    "url": "https://github.com/hyeonse-swing/browser-error-log/issues"
  }
}
