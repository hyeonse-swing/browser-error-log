{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@browser-error-log/protocol": ["./packages/protocol/src/index.ts"],
      "@browser-error-log/browser": ["./packages/browser/src/index.ts"],
      "@browser-error-log/react": ["./packages/react/src/index.tsx"]
    }
  },
  "include": ["packages", "apps", "examples/micro-server/src", "tests", "vite.config.ts", "vitest.config.ts"]
}
