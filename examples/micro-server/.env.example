# Examples only. Do not put server secrets in the browser SDK.
MICRO_STORAGE=sqlite
MICRO_HOST=127.0.0.1
MICRO_PORT=4319
MICRO_PROJECTS=my-web
MICRO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MICRO_DATA_DIR=.data/micro-server
MICRO_RETENTION_DAYS=7
MICRO_MAX_EVENTS=10000
MICRO_MAX_DB_MB=64
MICRO_LOG_FILE_MB=8
MICRO_LOG_FILES=3
MICRO_REQUESTS_PER_MINUTE=120
# Public mode additionally needs MICRO_PUBLIC_URL=https://errors.example.com
# and MICRO_VIEWER_PASSWORD supplied through runtime environment/secret storage.
